# Copie para .env.local e preencha.

# Chave da API do Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Para onde vão os briefings do formulário de diagnóstico.
CONTACT_EMAIL_TO=

# Remetente. Precisa ser de um domínio verificado no Resend.
# Sem domínio verificado, deixe vazio: o site usa onboarding@resend.dev,
# que só entrega para o e-mail da própria conta do Resend.
CONTACT_EMAIL_FROM=

# Cloudflare Turnstile (proteção anti-robô do formulário):
# https://dash.cloudflare.com/?to=/:account/turnstile
# Cadastre o domínio do site (e localhost, para testar) e copie as duas chaves.
# Fora de produção, se ficarem vazias, o site usa as chaves de teste do Cloudflare,
# que sempre aprovam. Em produção elas são obrigatórias.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
